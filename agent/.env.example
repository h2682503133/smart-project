# 环境变量模板：复制为 .env 并按环境填写（.env 不入库）
# 敏感配置只走环境变量，config.yaml 中对应位置为 ${VAR} 占位

# LLM（DeepSeek）
LLM_API_KEY=sk-xxx
# Embedding（火山方舟 multimodal 接口的 API Key）
EMBEDDING_API_KEY=ark-xxx
# Redis 密码（本地无密码留空）
REDIS_PASSWORD=
# Milvus token（本地无认证留空）
MILVUS_TOKEN=
# MinIO Secret Key
MINIO_SECRET_KEY=minioadmin
# JWT 签名密钥（必须与 Go 端 JWT_SECRET 一致，≥32 字符）
JWT_SECRET=change-me-same-as-go-32chars-min
# Go 内部服务密钥（必须与 Go 端 INTERNAL_SERVICE_KEY 一致，≥32 字符）
GO_INTERNAL_KEY=change-me-shared-32chars-min
